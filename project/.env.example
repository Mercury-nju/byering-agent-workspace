# Recovered configuration names only. Never put production values in this file.
MARVIS_BUGLY_APP_ID=
MARVIS_BUGLY_APP_KEY=
MARVIS_GALILEO_MIN_LEVEL=
MARVIS_GALILEO_TOKEN=
MARVIS_QIMEI_APPKEY=

# Development-only recovered Gateway timeline. Keep disabled for real runs.
MARVIS_ENABLE_GATEWAY_MOCK=0

# Byering requirement-understanding Agent (Doubao OpenAI-compatible chat API)
BYERING_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Display model: Doubao-Seed-2.1-pro; Ark online model ID:
BYERING_LLM_MODEL=doubao-seed-2-1-pro-260628
BYERING_LLM_API_KEY=
BYERING_LLM_TIMEOUT_MS=60000
BYERING_LLM_MAX_ATTEMPTS=2
BYERING_INBOX_PLAN_SIGNING_SECRET=

# Legacy ClueHunter execution service. Keep this service private; the
# connector adds request signing and forwards the per-account JWT when set.
BYERING_CLUEHUNTER_BASE_URL=
BYERING_CLUEHUNTER_SIGNING_SECRET=
BYERING_CLUEHUNTER_AUTH_TOKEN=
# Set to /api/rpa/robot/submit after the legacy Java command endpoint and
# rpa_submit_command migration are deployed; the connector maps its contract.
BYERING_CLUEHUNTER_SUBMIT_PATH=
# Secret used by ClueHunter to sign POST /v1/connectors/cluehunter/events callbacks.
BYERING_CLUEHUNTER_EVENT_SECRET=

# Legacy ClueHunter cloud desktop provisioning. Set mode=cluehunter in a
# deployment only after the Java service endpoint and numeric tenant/user
# identity are available. The browser-session route fails closed when these
# values are missing; it never falls back to a local browser in that mode.
BYERING_CLOUD_DESKTOP_MODE=cluehunter
BYERING_CLUEHUNTER_TENANT_ID=
BYERING_CLUEHUNTER_UID=
# Optional per-Agent override for public comment replies. Keep these on the
# server; they are the numeric RPA tenant/robot identity, not the Douyin uid.
BYERING_CLUEHUNTER_TENANT_ID_MKT_COMMENT_ACQUISITION=
BYERING_CLUEHUNTER_UID_MKT_COMMENT_ACQUISITION=
BYERING_CLUEHUNTER_REGION_ID=
# Optional legacy robot binding when the tenant has more than one robot.
BYERING_CLUEHUNTER_ROBOT_INFO_ID=
BYERING_CLUEHUNTER_CLOUD_APPLY_PATH=/api/cloud/desktop/apply
BYERING_CLUEHUNTER_CLOUD_STATUS_PATH=/api/cloud/desktop/applyStatus
# The legacy Java RPA controller exposes GET /self/rpa/startJob.
BYERING_CLUEHUNTER_RPA_START_JOB_PATH=/self/rpa/startJob
BYERING_CLUEHUNTER_RPA_START_JOB_METHOD=GET
BYERING_CLUEHUNTER_CLOUD_TIMEOUT_MS=15000
BYERING_CLUEHUNTER_CLOUD_POLL_INTERVAL_MS=2000
BYERING_CLUEHUNTER_CLOUD_WAIT_TIMEOUT_MS=120000

# Public Douyin prospect discovery (separate from ClueHunter/RPA). The
# legacy SpiderApi supports known-account video and video-comment pulls. Set
# BYERING_PROSPECT_SEARCH_ENABLED=1 only when a real keyword-search provider
# is deployed at BYERING_PROSPECT_SEARCH_PATH.
BYERING_PROSPECT_SPIDER_BASE_URL=
BYERING_PROSPECT_SPIDER_API_TOKEN=
BYERING_PROSPECT_SPIDER_TIMEOUT_MS=30000
BYERING_PROSPECT_VIDEO_LIST_PATH=/api/v1/douyin/video-list
BYERING_PROSPECT_COMMENTS_PATH=/api/v1/douyin/comments
BYERING_PROSPECT_SEARCH_PATH=/api/v1/douyin/search
BYERING_PROSPECT_SEARCH_ENABLED=0
# Streamable HTTP MCP for real public video/comment collection. When set, it
# takes precedence over the legacy SpiderApi connector above.
BYERING_DOUYIN_DATA_MCP_URL=http://118.196.143.56:8080/mcp
BYERING_DOUYIN_DATA_MCP_TIMEOUT_MS=120000
# Internal callback endpoint template. `{taskId}`, `{taskRunId}`,
# `{conversationId}` and `{goal}` are filled by the control plane.
BYERING_PROSPECT_CALLBACK_URL=
BYERING_PROSPECT_EVENT_SECRET=
# Account identity resolver used by the acquisition strategist before public
# SpiderApi collection. It converts a visible Douyin handle/name/profile URL
# into uid + sec_id. Keep empty only when callers always provide both IDs.
# Set provider=tikhub to use the built-in TikHub adapter; it supports handle,
# profile URL, and account-name lookup without deploying another proxy.
BYERING_PROSPECT_ACCOUNT_RESOLVER_PROVIDER=
BYERING_PROSPECT_TIKHUB_API_KEY=
BYERING_PROSPECT_TIKHUB_BASE_URL=https://api.tikhub.io
BYERING_PROSPECT_ACCOUNT_RESOLVER_URL=
BYERING_PROSPECT_ACCOUNT_RESOLVER_API_KEY=

# Durable control-plane state directory used by the production HTTP server.
BYERING_PERSISTENCE_DIR=

# Control-plane API authentication. Use tenant-id=secret pairs in production.
# The service stays anonymous for local development when these are empty.
BYERING_CONTROL_PLANE_AUTH_REQUIRED=0
BYERING_CONTROL_PLANE_API_KEYS=
BYERING_CONTROL_PLANE_API_KEY=
BYERING_CONTROL_PLANE_TENANT_ID=
BYERING_CONTROL_PLANE_ORIGINS=http://127.0.0.1:6680,http://localhost:6680

# One persistent Douyin browser profile per tenant/account. The registry keeps
# session/workspace bindings recoverable after a backend restart.
BYERING_BROWSER_PROFILE_ROOT=
BYERING_BROWSER_SESSION_REGISTRY=
BYERING_BROWSER_HEADLESS=0
BYERING_CHROME_PATH=

# Douyin MCP account cloud runtime. One authorized Douyin account owns one
# reusable cloud desktop for every Douyin product Agent.
BYERING_DOUYIN_MCP_PYTHON=
BYERING_DOUYIN_MCP_ADAPTER=
BYERING_DOUYIN_MCP_SERVER_URL=https://api.yydsagent.com
BYERING_DOUYIN_MCP_API_KEY=
BYERING_DOUYIN_MCP_API_KEY_MKT_DOUYIN_ACCOUNT_RUNTIME=
BYERING_DOUYIN_MCP_API_KEY_MKT_LEAD_MINER=
BYERING_DOUYIN_MCP_API_KEY_MKT_COMMENT_FILTER=
BYERING_DOUYIN_MCP_API_KEY_MKT_LIVE_LEAD_MINER=
# Optional diagnostics-only bound. Leave unset for provider-driven startup monitoring.
# BYERING_DOUYIN_PROVISIONING_TIMEOUT_MS=600000
